      "name": "01 세션 및 테스트 계정 준비",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const suffix=Date.now().toString(); pm.collectionVariables.set('userId','p'+suffix); pm.collectionVariables.set('email','p'+suffix+'@example.com');",
              "pm.test('CSRF 계약',()=>{pm.expect(pm.response.json()).to.have.keys('token','headerName');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/csrf"
      }
    },
    {
