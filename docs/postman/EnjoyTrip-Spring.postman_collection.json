          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({url:pm.variables.get('baseUrl')+'/api/auth/csrf',method:'GET'},(err,res)=>{",
              " if(err || res.code!==200) throw new Error('CSRF request failed');",
              " const csrf=res.json(); pm.request.headers.upsert({key:csrf.headerName,value:csrf.token});",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
