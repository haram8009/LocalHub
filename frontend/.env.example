# 백엔드 API 기본 경로. 개발 서버(Vite)가 /api 요청을 localhost:8080으로 전달합니다.
VITE_API_BASE_URL=/api

# 카카오 지도 표시용 JavaScript 키. 카카오 개발자 콘솔에 사용할 웹 도메인
# (예: http://localhost:5173)을 등록해야 합니다.
VITE_KAKAO_MAP_JAVASCRIPT_KEY=

# 관광지 데이터 소스. 백엔드 설정과 반드시 일치해야 합니다.
#   database: 백엔드 local,mysql 프로필(MySQL에 적재한 데이터). 관광정보 API 키 불필요
#   api     : 백엔드 local 프로필 + TOUR_API_KEY (한국관광공사 TourAPI)
VITE_TOUR_SOURCE=database
