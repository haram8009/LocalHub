{
	# 사용자 입장의 요청 수·지연·상태 코드(caddy_http_*)를 기록합니다.
	metrics {
		per_host
	}
}

# SITE_ADDRESS
#   운영: 도메인 (예: localhub.duckdns.org) → Let's Encrypt 인증서를 자동 발급·갱신합니다.
#   로컬 테스트: :80 → HTTPS 없이 HTTP 로만 동작합니다.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 헬스체크·메트릭은 내부 전용입니다.
	@internal path /actuator /actuator/*
	respond @internal 404

	# 활성 색(blue/green)의 reverse_proxy 설정. deploy.sh 가 이 디렉터리의 파일을 교체합니다.
	import /etc/caddy/upstream/*.caddy
}

# Prometheus 수집용. 이 포트는 compose 에서 호스트로 열지 않으므로 Docker 내부 네트워크에서만 접근됩니다.
:2020 {
	metrics /metrics
}
