# 서버의 docker-compose.yml 옆에 .env 로 복사해 값을 채웁니다. (Git에 올리지 마세요)

# 이미지 경로(소문자). GitHub: ghcr.io/<계정 또는 조직>/<저장소>
# 실제 이미지는 ${IMAGE_PREFIX}-app(프론트+백엔드), ${IMAGE_PREFIX}-db 로 만들어집니다.
# 앱 이미지 태그(커밋 SHA)는 deploy.sh 가 .deploy-state 에 기록하므로 여기에 적지 않습니다.
IMAGE_PREFIX=ghcr.io/your-account/enjoytrip

# 접속 주소. 도메인을 쓰면 HTTPS 인증서가 자동 발급됩니다. 로컬 테스트는 :80
SITE_ADDRESS=localhub.duckdns.org
# HTTPS 가 아니면 false (로컬 HTTP 테스트에서만)
JWT_COOKIE_SECURE=true

# JWT 서명 키: 32바이트 이상 임의 문자열. 바꾸면 모든 로그인이 풀립니다.
#   생성 예: openssl rand -base64 48
JWT_SECRET=

# MySQL (비밀번호는 충분히 길게)
DB_ROOT_PASSWORD=
DB_USERNAME=ssafy
DB_PASSWORD=

# 카카오 REST API 키 (지역명 조회·길찾기). 지도 표시용 JavaScript 키는 이미지 빌드 시 주입됩니다.
KAKAO_REST_API_KEY=

# 게시글이 비어 있을 때 샘플 게시글 생성 여부
SEED_DEMO=false
