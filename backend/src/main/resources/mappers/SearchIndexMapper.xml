<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enjoytrip.SearchIndexMapper">
<!-- 부분 일치(LIKE '%q%')는 인덱스를 못 쓰므로, 게시글마다 중복된 postings(약 100만 행) 대신
     서로 다른 단어만 모은 사전(post_search_terms, 수만 행)을 훑고 postings 는 PK(term_hash, post_id)로 찾습니다.
     사전에는 지워진 단어가 남아 있을 수 있지만 postings 와 조인하므로 결과에 영향이 없습니다. -->
<select id="findContaining" resultType="com.enjoytrip.PostSearchIndexRepository$Posting">SELECT p.term,p.post_id,p.title_hit,p.body_hit FROM post_search_terms t JOIN post_search_postings p ON p.term_hash=t.term_hash WHERE <foreach collection="patterns" item="pattern" open="(" separator=" OR " close=")">t.term LIKE #{pattern} ESCAPE '!'</foreach></select>
<insert id="add">INSERT INTO post_search_postings(term_hash,post_id,term,title_hit,body_hit) VALUES(#{termHash},#{post.id},#{term},#{titleHit},#{bodyHit})</insert>
<insert id="addTerm" databaseId="mysql">INSERT IGNORE INTO post_search_terms(term_hash,term) VALUES(#{termHash},#{term})</insert>
<insert id="addTerm" databaseId="h2">MERGE INTO post_search_terms(term_hash,term) KEY(term_hash) VALUES(#{termHash},#{term})</insert>
<!-- 사전에 없는 단어를 postings 에서 찾습니다. 기동 시 실행: V2 이전 버전(사전을 모름)이 쓴 글도 반영됩니다.
     GROUP BY term_hash + MIN(post_id) 는 PK(term_hash, post_id) 를 단어 수(수만)만큼만 건너뛰며 읽고(loose index scan),
     잠그지 않는 일반 SELECT 라서 그동안 들어오는 글쓰기를 막지 않습니다.
     (예전: 행마다 MIN 서브쿼리를 도는 INSERT ... SELECT 라 100만 행에서 9분 넘게 걸리고 읽은 행을 잠갔습니다.) -->
<select id="findMissingTerms" resultType="com.enjoytrip.PostSearchIndexRepository$DictionaryTerm">SELECT p.term_hash,p.term FROM (SELECT term_hash,MIN(post_id) AS post_id FROM post_search_postings GROUP BY term_hash) m JOIN post_search_postings p ON p.term_hash=m.term_hash AND p.post_id=m.post_id WHERE NOT EXISTS (SELECT 1 FROM post_search_terms t WHERE t.term_hash=m.term_hash)</select>
<insert id="addTerms" databaseId="mysql">INSERT IGNORE INTO post_search_terms(term_hash,term) VALUES <foreach collection="terms" item="t" separator=",">(#{t.termHash},#{t.term})</foreach></insert>
<insert id="addTerms" databaseId="h2">MERGE INTO post_search_terms(term_hash,term) KEY(term_hash) VALUES <foreach collection="terms" item="t" separator=",">(#{t.termHash},#{t.term})</foreach></insert>
<delete id="remove">DELETE FROM post_search_postings WHERE post_id=#{id}</delete>
<delete id="removeByAuthor">DELETE FROM post_search_postings WHERE post_id IN (SELECT id FROM travel_posts WHERE author_id=#{id})</delete>
<delete id="clear">DELETE FROM post_search_postings</delete>
<delete id="clearTerms">DELETE FROM post_search_terms</delete>
<select id="version" resultType="string">SELECT version FROM search_index_state WHERE name='posts'</select>
<delete id="deleteState">DELETE FROM search_index_state WHERE name='posts'</delete>
<insert id="insertState">INSERT INTO search_index_state(name,version) VALUES('posts',#{version})</insert>
</mapper>
