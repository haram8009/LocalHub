<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enjoytrip.PostMapper">
<resultMap id="locationSnapshot" type="com.enjoytrip.PostRepository$LocationSnapshot">
<result property="postId" column="post_id"/><association property="location" javaType="com.enjoytrip.PostLocation"><result property="contentId" column="content_id"/><result property="contentTypeId" column="content_type_id"/><result property="name" column="name"/><result property="category" column="category"/><result property="address" column="address"/><result property="region" column="region"/><result property="description" column="description"/><result property="tel" column="tel"/><result property="latitude" column="latitude"/><result property="longitude" column="longitude"/><result property="thumbnailImageUrl" column="thumbnail_image_url"/><result property="originalImageUrl" column="original_image_url"/><result property="visitOrder" column="visit_order"/></association></resultMap>
<sql id="ids"><foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></sql>
<select id="findById" resultType="com.enjoytrip.TravelPost">SELECT * FROM travel_posts WHERE id=#{id}</select>
<select id="findLockedById" resultType="com.enjoytrip.TravelPost">SELECT * FROM travel_posts WHERE id=#{id} FOR UPDATE</select>
<select id="count" resultType="long">SELECT COUNT(*) FROM travel_posts</select>
<select id="existsById" resultType="boolean">SELECT COUNT(*) > 0 FROM travel_posts WHERE id=#{id}</select>
<insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO travel_posts(category,title,content,author_id,author_name,view_count,created_at,updated_at) VALUES(#{category},#{title},#{content},#{authorId},#{authorName},#{viewCount},#{createdAt},#{updatedAt})</insert>
<update id="update">UPDATE travel_posts SET category=#{category},title=#{title},content=#{content},author_name=#{authorName},view_count=#{viewCount},created_at=#{createdAt},updated_at=#{updatedAt} WHERE id=#{id}</update>
<update id="incrementViews">UPDATE travel_posts SET view_count=view_count+1 WHERE id=#{id}</update>
<delete id="deleteById">DELETE FROM travel_posts WHERE id=#{id}</delete>
<delete id="deleteAll">DELETE FROM travel_posts</delete>
<select id="findIdsByAuthor" resultType="long">SELECT id FROM travel_posts WHERE author_id=#{author} ORDER BY id FOR UPDATE</select>
<delete id="deleteLocations">DELETE FROM post_locations WHERE post_id=#{id}</delete>
<insert id="insertLocation">INSERT INTO post_locations(post_id,visit_index,content_id,content_type_id,name,category,address,region,description,tel,latitude,longitude,thumbnail_image_url,original_image_url,visit_order) VALUES(#{id},#{index},#{location.contentId},#{location.contentTypeId},#{location.name},#{location.category},#{location.address},#{location.region},#{location.description},#{location.tel},#{location.latitude},#{location.longitude},#{location.thumbnailImageUrl},#{location.originalImageUrl},#{location.visitOrder})</insert>
<select id="findLocationSnapshots" resultMap="locationSnapshot">SELECT * FROM post_locations WHERE post_id IN <include refid="ids"/> ORDER BY post_id,visit_index</select>
<select id="findWithLocationsByIds" resultType="com.enjoytrip.TravelPost">SELECT * FROM travel_posts WHERE id IN <include refid="ids"/></select>
<sql id="filters"><where><if test="category != null and category != ''">AND category=#{category}</if><if test="authorId != null and authorId != ''">AND author_id=#{authorId}</if><if test="keyword != null and keyword != ''">AND LOWER(CONCAT(title,' ',content)) LIKE #{keyword} ESCAPE '!'</if></where></sql>
<select id="list" resultType="com.enjoytrip.TravelPost">SELECT * FROM travel_posts <include refid="filters"/> ORDER BY created_at DESC,id DESC <if test="limit != null">LIMIT #{limit} OFFSET #{offset}</if></select>
<select id="countFiltered" resultType="long">SELECT COUNT(*) FROM travel_posts <include refid="filters"/></select>
<select id="scan" resultType="com.enjoytrip.TravelPost">SELECT * FROM travel_posts ORDER BY id LIMIT #{limit} OFFSET #{offset}</select>
<select id="findCourseCandidateIds" resultType="long">SELECT DISTINCT post_id FROM post_locations WHERE post_id != #{baseId} AND content_id IN <foreach collection="placeIds" item="place" open="(" separator="," close=")">#{place}</foreach></select>
<select id="findCoursePoints" resultType="com.enjoytrip.PostRepository$CoursePoint">SELECT post_id,content_id,visit_order FROM post_locations WHERE post_id IN <include refid="ids"/> ORDER BY post_id,visit_order</select>
<select id="findCourseSummaries" resultType="com.enjoytrip.PostRepository$CourseSummary">SELECT p.*, (SELECT COUNT(*) FROM post_locations l WHERE l.post_id=p.id) AS location_count FROM travel_posts p WHERE p.id IN <include refid="ids"/></select>
<select id="findCourseTimestamps" resultType="com.enjoytrip.PostRepository$CourseTimestamp">SELECT id,created_at FROM travel_posts WHERE id IN <include refid="ids"/></select>
<select id="findSearchMetadata" resultType="com.enjoytrip.PostRepository$SearchMetadata">SELECT id,created_at FROM travel_posts WHERE id IN <include refid="ids"/> AND (#{category}='' OR category=#{category}) AND (#{author}='' OR author_id=#{author})</select>
<select id="findNearbyPoints" resultType="com.enjoytrip.PostRepository$NearbyPoint">SELECT l.*,p.created_at FROM post_locations l JOIN travel_posts p ON p.id=l.post_id WHERE latitude BETWEEN #{minLatitude} AND #{maxLatitude} AND longitude BETWEEN #{minLongitude} AND #{maxLongitude} ORDER BY post_id,visit_order</select>
</mapper>
