<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enjoytrip.MemberMapper">
<select id="findById" resultType="com.enjoytrip.Member">SELECT * FROM members WHERE id=#{id}</select>
<select id="findLockedById" resultType="com.enjoytrip.Member">SELECT * FROM members WHERE id=#{id} FOR UPDATE</select>
<select id="findByNameAndEmail" resultType="com.enjoytrip.Member">SELECT * FROM members WHERE name=#{name} AND email=#{email}</select>
<select id="findByIdAndEmail" resultType="com.enjoytrip.Member">SELECT * FROM members WHERE id=#{id} AND email=#{email}</select>
<select id="existsById" resultType="boolean">SELECT COUNT(*) > 0 FROM members WHERE id=#{id}</select>
<select id="existsByEmail" resultType="boolean">SELECT COUNT(*) > 0 FROM members WHERE email=#{email}</select>
<select id="count" resultType="long">SELECT COUNT(*) FROM members</select>
<insert id="insert">INSERT INTO members(id,password_hash,name,email,created_at,credential_version) VALUES(#{id},#{passwordHash},#{name},#{email},#{createdAt},#{credentialVersion})</insert>
<update id="update">UPDATE members SET password_hash=#{passwordHash},name=#{name},email=#{email},credential_version=#{credentialVersion} WHERE id=#{id}</update>
<delete id="delete">DELETE FROM members WHERE id=#{id}</delete>
<delete id="deleteAll">DELETE FROM members</delete>
</mapper>
